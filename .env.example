# Docusure AI Configuration Environment Variables

# Optional AI enhancement (Gemini or OpenAI API Key)
# When left blank, Docusure AI runs 100% deterministically with local verified explanations
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server & Security Configuration
PORT=8000
HOST=127.0.0.1
MAX_FILE_SIZE_BYTES=10485760 # 10 MB per file limit
MAX_FILES_PER_SUBMISSION=10

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///./backend/data/docusure.db
